
<% if task.errors.any? %>
  <div>
    <h2>
      <%= pluralize(task.errors.count, "error") %>
      prevented this task from being saved:
    </h2>

    <ul>
      <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: task do |form| %>
  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>

  <br>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <br>

  <div>
    <%= form.label :status %><br>
    <%= form.select :status,
                    [["Pending", "pending"],
                     ["Completed", "completed"]] %>
  </div>

  <br>

  <div>
    <%= form.label :due_date %><br>
    <%= form.date_field :due_date %>
  </div>

  <br>

  <div>
    <%= form.submit %>
  </div>
<% end %>
